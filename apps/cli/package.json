{
  "name": "doorframe",
  "version": "0.1.3",
  "description": "Local-first Doorframe web app launcher, traceability report generator, demo runner, and read-only MCP launcher.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtboyarc/Doorframe.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/vtboyarc/Doorframe#readme",
  "bugs": {
    "url": "https://github.com/vtboyarc/Doorframe/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "doorframe": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs",
    "lint": "npm run typecheck",
    "prepack": "npm run build && npm --prefix ../.. run build:web && node ../../scripts/prepare-cli-package.mjs && npm run test:bin",
    "prepublishOnly": "npm --prefix ../.. run typecheck && npm --prefix ../.. run lint && npm --prefix ../.. test && npm run build && npm --prefix ../.. run build:web && node ../../scripts/prepare-cli-package.mjs && npm run test:bin",
    "test": "vitest run src/__tests__/*.test.ts",
    "test:bin": "node ../../scripts/smoke-cli-bin.mjs",
    "typecheck": "tsc -p ../../tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reactflow": "^11.11.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
