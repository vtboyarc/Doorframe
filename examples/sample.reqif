<REQ-IF>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="REQ-006" LONG-NAME="Packet validation">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The system shall reject telemetry packets with invalid checksums before updating the operator display." />
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-007" LONG-NAME="Operator message wording">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The system may show an appropriate warning if practical." />
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
