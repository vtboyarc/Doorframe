<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DT-STRING" LONG-NAME="String" />
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="DT-STATUS" LONG-NAME="Status enum">
          <SPECIFIED-VALUES>
            <ENUM-VALUE IDENTIFIER="STATUS-APPROVED" LONG-NAME="Approved" />
            <ENUM-VALUE IDENTIFIER="STATUS-DRAFT" LONG-NAME="Draft" />
          </SPECIFIED-VALUES>
        </DATATYPE-DEFINITION-ENUMERATION>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="OT-REQ" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-TEXT" LONG-NAME="Text" />
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-PRIORITY" LONG-NAME="Priority" />
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="AD-VERIFY" LONG-NAME="Verification Method" />
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="AD-STATUS" LONG-NAME="Status" />
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="REQ-006" LONG-NAME="Packet validation">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The system shall reject telemetry packets with invalid checksums before updating the operator display.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="High">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-PRIORITY</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Test">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-VERIFY</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-STATUS</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>STATUS-APPROVED</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="REQ-007" LONG-NAME="Operator message wording">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The system may show an appropriate warning if practical.">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>AD-TEXT</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>AD-STATUS</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>STATUS-DRAFT</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPEC-1" LONG-NAME="Telemetry spec">
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="SH-006">
              <OBJECT><SPEC-OBJECT-REF>REQ-006</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="SH-007">
                  <OBJECT><SPEC-OBJECT-REF>REQ-007</SPEC-OBJECT-REF></OBJECT>
                </SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
